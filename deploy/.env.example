# ===== JumpServer deploy env — copy to deploy/.env and fill in =====
# Target: stable v4.10.18-ce (CLJUMPSERV-4 decision).
# Generate secrets:
#   SECRET_KEY     : cat /dev/urandom | tr -dc A-Za-z0-9 | head -c 48; echo
#   BOOTSTRAP_TOKEN: cat /dev/urandom | tr -dc A-Za-z0-9 | head -c 24; echo
#   DB/REDIS pass  : cat /dev/urandom | tr -dc A-Za-z0-9 | head -c 24; echo

# --- images ---
# Official stable core image (do NOT use the fork dev HEAD — it carries the unreleased
# single-port magnus change that has no matching magnus component yet).
CORE_IMAGE=jumpserver/core:v4.10.18-ce
COMPONENT_TAG=v4.10.18-ce     # koko / lion / chen / web (aligned with core)
MAGNUS_TAG=v3.10.22           # magnus ships on its own v3.10.x line (no v4 tag exists)

# --- secrets ---
SECRET_KEY=CHANGE_ME_48_chars
BOOTSTRAP_TOKEN=CHANGE_ME_24_chars

# --- database (self-hosted postgres container) ---
DB_ENGINE=postgresql
DB_HOST=postgresql
DB_PORT=5432
DB_USER=jumpserver
DB_PASSWORD=CHANGE_ME
DB_NAME=jumpserver

# --- redis (self-hosted redis container) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- runtime ---
TZ=Asia/Taipei
LOG_LEVEL=ERROR

# --- published ports (host side) ---
HTTP_PORT=80          # web entry; front it with TLS reverse proxy (CLJUMPSERV-11)
SSH_PORT=2222         # koko SSH entry

# --- magnus DB-proxy ports (per-protocol, v3.10.x 7-port model) ---
MAGNUS_MYSQL_PORT=33061
MAGNUS_MARIADB_PORT=33062
MAGNUS_REDIS_PORT=63790
MAGNUS_POSTGRESQL_PORT=54320
MAGNUS_SQLSERVER_PORT=14330
MAGNUS_ORACLE_PORT=15210
MAGNUS_MONGODB_PORT=27018
